# Every input the Spark run uses, pinned. bootstrap.sh refuses to start while any value is empty.
# Resolved 2026-09-28 from the public HF / GitHub APIs; re-verify if you change a pin.

# Contrastive-LM code, vendored from source at a commit (NOT `pip install contrastive-lm`, v0.1.0,
# first published 2026-09-24 by a single author).
CLM_REPO=https://github.com/Contrastive-LM/CLM
CLM_COMMIT=bb42c6c5bf914fd449bed2f6ca65be80602cb1f7

# CLM reference head: a PyTorch pickle. Loaded ONCE with weights_only=True, checked to be tensors
# only, re-saved, and the original deleted.
CLM_HEAD_REPO=Contrastive-LM/CLM-v0.1-8B
CLM_HEAD_REV=e939398d4556fcd9400c76fa8c5a513202f42b0a
CLM_HEAD_FILE=CLM_v0.1-8B.pt
CLM_HEAD_SHA256=b2b4a8c9c2d39263eff78a351eb909a342ce9b3bf21a3f07c1d1bf15f1c4eda5

# Encoder named by the head's own config.json ("base_model": "Qwen/Qwen3-8B", last-token pooling)
ENCODER_REPO=Qwen/Qwen3-8B
ENCODER_REV=b968826d9c46dd6066d109eabc6255188de91218

# Small generative model for the SLM arm (36B total, ~3B active)
SLM_REPO=Qwen/Qwen3.6-35B-A3B
SLM_REV=995ad96eacd98c81ed38be0c5b274b04031597b0

# REQUIRED, operator-supplied: an aarch64 vLLM image supported on GB10, pinned BY DIGEST,
# e.g. registry/image@sha256:<64 hex>. NVIDIA's DGX Spark vLLM container is the expected source.
VLLM_IMAGE=

# REQUIRED: the frozen held-out states file shipped with the run (see README) and its sha256
HELDOUT_FILE=heldout_states.jsonl
HELDOUT_SHA256=b4ccde6a9eb4632ff47df6a3871d1ce98ae6b1340080793398164dd08635b552

# REQUIRED: the only IP allowed to SSH in (the operator's egress IP)
OPERATOR_IP=
